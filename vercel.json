{
  "framework": null,
  "buildCommand": "python3 build_html.py",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/telegram-post", "schedule": "0 2 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.allergy.tj" }],
      "destination": "https://allergy.tj/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/en/:path*", "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(TelegramBot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|Discordbot|vkShare|Pinterestbot).*" }], "destination": "/api/og?lang=en" },
    { "source": "/ru/:path*", "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(TelegramBot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|Discordbot|vkShare|Pinterestbot).*" }], "destination": "/api/og?lang=ru" },
    { "source": "/", "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(TelegramBot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|Discordbot|vkShare|Pinterestbot).*" }], "destination": "/api/og?lang=tj" },
    { "source": "/en/:path*", "destination": "/en/index.html" },
    { "source": "/ru/:path*", "destination": "/ru/index.html" },
    { "source": "/tj/:path*", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'sha256-YDwk8BupC/HHCFpoXWru5SjztQupkTg9234NeIgNK0M=' 'sha256-rbTaSdDD+Sd+K8IZ66VS79bdI78bN8AwXXyN0/lD5fY='; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.open-meteo.com https://air-quality-api.open-meteo.com https://wttr.in; img-src 'self' data:; font-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'" }
      ]
    }
  ]
}
